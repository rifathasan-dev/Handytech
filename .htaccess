# HandyTech.sg Apache config (shared hosting / XAMPP compatible).
# Every section is guarded so the site still runs if a module is missing.

DirectoryIndex index.html

# Never show folder listings (a missing page shows 404, not files)
Options -Indexes

# --- Canonical host: force https + non-www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\. [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.handytech\.sg$ [NC]
  RewriteRule ^(.*)$ https://handytech.sg/$1 [R=301,L]
  # /index.html -> site root (never show /index)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L,NE]
  # /path/index.html -> /path/ (clean directory URLs)
  RewriteCond %{THE_REQUEST} \s/(.+/)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # canonical: redirect /page.html to clean /page
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # drop trailing slash for one canonical form (skip real files)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]
  # /services is a folder on disk but a page on the site
  RewriteRule ^services/?$ services/index.html [NC,L]
  # resolve: serve page.html content for clean /page URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# --- Browser caching for static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/avif "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType font/woff "access plus 90 days"
  ExpiresByType font/woff2 "access plus 90 days"
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Block direct access to this file ---
<Files ".htaccess">
  Require all denied
</Files>
