# HandyTech.sg Apache config (shared hosting / XAMPP compatible).
# Every section is guarded so the site still runs if a module is missing.

# --- Canonical host: force https + non-www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.handytech\.sg$ [NC]
  RewriteRule ^(.*)$ https://handytech.sg/$1 [R=301,L]
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# --- Browser caching for static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/avif "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType font/woff "access plus 90 days"
  ExpiresByType font/woff2 "access plus 90 days"
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Block direct access to this file ---
<Files ".htaccess">
  Require all denied
</Files>
